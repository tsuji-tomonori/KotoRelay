{
  "name": "kotorelay",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "lint": "eslint frontend e2e tools/project --max-warnings 0",
    "format": "prettier --write frontend e2e tools/project/*.mjs *.json *.yml .github/workflows",
    "format:check": "prettier --check frontend e2e tools/project/*.mjs *.json *.yml .github/workflows",
    "typecheck": "npm run check --workspace frontend && tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "cdk": "cdk",
    "requirements:check": "python3 tools/quintflow.py check"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@informalsystems/quint": "0.32.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@vitest/coverage-v8": "^5.0.0",
    "aws-cdk": "^2.1030.0",
    "eslint": "^9.30.0",
    "eslint-plugin-astro": "^1.3.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "adm-zip": "0.6.1"
  }
}
